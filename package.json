{
  "name": "fifteen-game",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --configLoader runner",
    "test:integration": "node scripts/run-firebase-integration.js",
    "test:integration:run": "vitest run --config vitest.integration.config.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test tests/e2e/production-smoke.spec.js --config=playwright.production.config.js",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "test:full": "npm run test:all && npm run test:e2e:prod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.54.2",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.24.0",
    "vitest": "^3.2.4"
  }
}
